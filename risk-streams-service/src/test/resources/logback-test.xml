<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Same filter as the service: no Windows-only state-directory permission noise in test output. -->
  <turboFilter class="com.aerotrace.riskstreams.StateDirectoryPermissionNoiseFilter"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
