# Local development settings. Copy this file to `.env` (git-ignored) and adjust the values.
#
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically for the compose files in this directory, and the
# Spring Boot services read it too when started from the IDE or Maven (they import `.env`, or
# `../.env` when started from a module folder). Real environment variables always win over it.
# Dev-only values: never reuse them outside local development.

# Eureka (discovery-server). Clients register with these credentials; the server has no default
# password and refuses to start without one.
EUREKA_USER=eureka
EUREKA_PASSWORD=eureka

# Redis runs with requirepass; the gateway authenticates with the same password.
REDIS_PASSWORD=change-me-redis

# PostgreSQL (docker compose)
POSTGRES_USER=aerotrace
POSTGRES_PASSWORD=aerotrace
POSTGRES_DB=aerotrace

# api-gateway when started from the IDE or Maven: where identity-service issues and publishes
# tokens. (Inside Docker Compose the gateway uses COMPOSE_JWT_ISSUER / COMPOSE_JWK_SET_URI instead,
# because the identity-service hostname differs from localhost.)
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=aerotrace-api
JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
