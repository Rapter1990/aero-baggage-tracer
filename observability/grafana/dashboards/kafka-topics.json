      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ span.messaging.system = \"kafka\" && span.messaging.destination.name =~ \"${topic:regex}\" && duration >= ${min_duration} } | select(span.messaging.destination.name, span.messaging.operation)",
          "limit": 50,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
