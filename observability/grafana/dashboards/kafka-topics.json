{
  "uid": "aerotrace-kafka-topics",
  "title": "AeroTrace - Kafka Topics",
  "tags": [
    "aerotrace",
    "kafka"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Other AeroTrace dashboards",
      "type": "dashboards",
      "tags": [
        "aerotrace"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "topic",
        "label": "Topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kafka_producer_topic_record_send_total, topic)",
          "refId": "topic"
        },
        "definition": "label_values(kafka_producer_topic_record_send_total, topic)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "min_duration",
        "label": "Slower than",
        "type": "custom",
        "query": "0ms,10ms,50ms,100ms,250ms,500ms,1s,5s",
        "options": [
          {
            "text": "0ms",
            "value": "0ms",
            "selected": true
          },
          {
            "text": "10ms",
            "value": "10ms",
            "selected": false
          },
          {
            "text": "50ms",
            "value": "50ms",
            "selected": false
          },
          {
            "text": "100ms",
            "value": "100ms",
            "selected": false
          },
          {
            "text": "250ms",
            "value": "250ms",
            "selected": false
          },
          {
            "text": "500ms",
            "value": "500ms",
            "selected": false
          },
          {
            "text": "1s",
            "value": "1s",
            "selected": false
          },
          {
            "text": "5s",
            "value": "5s",
            "selected": false
          }
        ],
        "current": {
          "selected": true,
          "text": "0ms",
          "value": "0ms"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this page",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "Pick one or more **topics** at the top. The numbers come from the Kafka producers of the services (today the journey-service) and from the traces of every send.\n\n* **Messages, errors, retries** - what the producers sent to the topic and what failed.\n* **Send duration** - time from calling `send` until the broker acknowledged the message (from the traces).\n* **Producer health** - request latency and queue time of the Kafka client itself.\n* **Sends (traces)** - one row per send; **click the Trace ID** to open it. The trace starts at the outbox relay (see the *Outbox* dashboard).\n\nTo look inside a topic (messages, partitions, consumer groups) use [Open Kafka UI](http://localhost:8090/ui/clusters/local/all-topics)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Messages sent",
      "description": "Messages the producers sent to the selected topics in the time range.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(kafka_producer_topic_record_send_total{topic=~\"$topic\"}[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ]
    },
