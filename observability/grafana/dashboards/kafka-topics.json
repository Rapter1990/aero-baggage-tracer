              "Name": 3,
              "name": 3,
              "messaging.destination.name": 4,
              "messaging.operation": 5,
              "Duration": 6,
              "duration": 6,
              "Trace Name": 7,
              "traceName": 7
            },
            "renameByName": {
              "traceIdHidden": "Trace ID",
              "Start time": "Time",
              "time": "Time",
              "service.name": "Service",
              "Name": "Operation",
              "name": "Operation",
              "Trace Name": "Trace starts with",
              "traceName": "Trace starts with",
              "messaging.destination.name": "Topic",
              "messaging.operation": "Operation"
            }
          }
        }
      ]
