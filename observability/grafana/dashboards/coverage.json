{
  "uid": "aerotrace-coverage",
  "title": "AeroTrace - Coverage",
  "tags": [
    "aerotrace",
    "coverage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Other AeroTrace dashboards",
      "type": "dashboards",
      "tags": [
        "aerotrace"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "module",
        "label": "Module",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jacoco_covered, module)",
          "refId": "module"
        },
        "definition": "label_values(jacoco_covered, module)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this page",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "JaCoCo test coverage per module. The numbers are loaded by `observability/push-jacoco.ps1`, which runs `mvn verify` and then pushes the reports:\n\n```\n./observability/push-jacoco.ps1\n```\n\nPick one or more **modules** at the top. Green means at or above the build gate (**90 %** of lines, **60 %** of branches in the api-gateway). *Report age* shows when a module was last pushed; the trend charts grow with every push."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Line coverage",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "100 * sum(jacoco_covered{counter=\"line\",module=~\"$module\"}) / ((sum(jacoco_covered{counter=\"line\",module=~\"$module\"}) + sum(jacoco_missed{counter=\"line\",module=~\"$module\"})) > 0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "noValue": "no report",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
