    {
      "id": 9,
      "type": "table",
      "title": "Classes with the most uncovered lines",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "topk(20, sum by (module, package, class) (jacoco_missed{counter=\"line\",module=~\"$module\"}) > 0)"
        },
        {
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "(100 * sum by (module, package, class) (jacoco_covered{counter=\"line\",module=~\"$module\"}) / ((sum by (module, package, class) (jacoco_covered{counter=\"line\",module=~\"$module\"}) + sum by (module, package, class) (jacoco_missed{counter=\"line\",module=~\"$module\"})) > 0)) and on (module, package, class) topk(20, sum by (module, package, class) (jacoco_missed{counter=\"line\",module=~\"$module\"}) > 0)"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "module": 0,
              "package": 1,
              "class": 2,
              "Value #A": 3,
              "Value #B": 4
            },
            "renameByName": {
              "module": "Module",
              "package": "Package",
              "class": "Class",
              "Value #A": "Uncovered lines",
              "Value #B": "Line coverage"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Uncovered lines",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
