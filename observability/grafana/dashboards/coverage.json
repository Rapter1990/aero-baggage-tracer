          "expr": "100 * sum(jacoco_covered{counter=\"method\",module=~\"$module\"}) / ((sum(jacoco_covered{counter=\"method\",module=~\"$module\"}) + sum(jacoco_missed{counter=\"method\",module=~\"$module\"})) > 0)"
        }
