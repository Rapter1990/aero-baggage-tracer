    {
      "id": 6,
      "type": "table",
      "title": "Coverage by module",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "100 * sum by (module) (jacoco_covered{counter=\"line\",module=~\"$module\"}) / ((sum by (module) (jacoco_covered{counter=\"line\",module=~\"$module\"}) + sum by (module) (jacoco_missed{counter=\"line\",module=~\"$module\"})) > 0)"
        },
        {
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "100 * sum by (module) (jacoco_covered{counter=\"branch\",module=~\"$module\"}) / ((sum by (module) (jacoco_covered{counter=\"branch\",module=~\"$module\"}) + sum by (module) (jacoco_missed{counter=\"branch\",module=~\"$module\"})) > 0)"
        },
        {
          "refId": "C",
          "instant": true,
          "format": "table",
          "expr": "100 * sum by (module) (jacoco_covered{counter=\"instruction\",module=~\"$module\"}) / ((sum by (module) (jacoco_covered{counter=\"instruction\",module=~\"$module\"}) + sum by (module) (jacoco_missed{counter=\"instruction\",module=~\"$module\"})) > 0)"
        },
        {
          "refId": "D",
          "instant": true,
          "format": "table",
          "expr": "100 * sum by (module) (jacoco_covered{counter=\"method\",module=~\"$module\"}) / ((sum by (module) (jacoco_covered{counter=\"method\",module=~\"$module\"}) + sum by (module) (jacoco_missed{counter=\"method\",module=~\"$module\"})) > 0)"
        },
        {
          "refId": "E",
          "instant": true,
          "format": "table",
          "expr": "sum by (module) (jacoco_missed{counter=\"line\",module=~\"$module\"})"
        },
        {
          "refId": "F",
          "instant": true,
          "format": "table",
          "expr": "time() - max by (module) (push_time_seconds{job=\"jacoco\",module=~\"$module\"})"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "module",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true
            },
            "indexByName": {
              "module": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "module": "Module",
              "Value #A": "Line %",
              "Value #B": "Branch %",
              "Value #C": "Instruction %",
              "Value #D": "Method %",
              "Value #E": "Uncovered lines",
              "Value #F": "Report age"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "cellOptions": {
              "type": "color-background"
            },
            "align": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "n/a",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Branch %"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 50
                    },
                    {
                      "color": "green",
                      "value": 60
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uncovered lines"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Report age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Module",
            "desc": false
          }
        ]
