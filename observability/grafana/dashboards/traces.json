              "Trace Name": 10, "traceName": 10, "Span ID": 11, "spanID": 11
            },
            "renameByName": {
              "traceIdHidden": "Trace ID", "Start time": "Time", "time": "Time", "service.name": "Service",
              "Name": "Operation", "name": "Operation", "method": "Method", "uri": "Route", "http.url": "URL",
              "status": "HTTP status", "outcome": "Outcome", "Trace Name": "Trace starts with", "traceName": "Trace starts with"
            }
          }
