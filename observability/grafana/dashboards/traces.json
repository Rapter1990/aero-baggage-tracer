          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && kind = server && (status = error || span.outcome =~ \".*ERROR\" || span.status =~ \"[45][0-9][0-9]\") } | select(span.method, span.uri, span.http.url, span.status, span.outcome)",
          "limit": 50,
          "tableType": "spans"
        }
      ],
      "transformations": [
